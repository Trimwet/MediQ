VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Google Calendar sync
# Get this from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=<your-oauth-client-id>.apps.googleusercontent.com

# DO NOT add VITE_SUPABASE_SERVICE_ROLE_KEY here or in .env.
# The service role key bypasses all Row-Level Security and is exposed to the
# browser by Vite for any VITE_* variable. Staff invite calls go through the
# invite-staff Edge Function which reads SUPABASE_SERVICE_ROLE_KEY (no VITE_
# prefix) from Supabase Secrets — set it via:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<key>
