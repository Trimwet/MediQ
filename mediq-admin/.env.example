VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# DO NOT add VITE_SUPABASE_SERVICE_ROLE_KEY here or in .env.
# The service role key bypasses all Row-Level Security and is exposed to the
# browser by Vite for any VITE_* variable. Staff invite calls go through the
# invite-staff Edge Function which reads SUPABASE_SERVICE_ROLE_KEY (no VITE_
# prefix) from Supabase Secrets — set it via:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<key>
#
# Email OTP (2FA) is sent through Brevo (https://brevo.com) by the send-otp
# Edge Function. Set these as Supabase secrets (never as VITE_* variables):
#   supabase secrets set BREVO_API_KEY=<your-brevo-api-key>
#   supabase secrets set BREVO_SENDER_EMAIL=<verified-sender@example.com>
#   supabase secrets set BREVO_SENDER_NAME=MediQ
#
# For local development, put the same keys in supabase/.env.local so `supabase
# start` injects them into the local Edge Runtime (this file is gitignored):
#   BREVO_API_KEY=...
#   BREVO_SENDER_EMAIL=...
#   BREVO_SENDER_NAME=MediQ